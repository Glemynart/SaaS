}

// =============================================================================
// PRODUCT SERVICE — Producto o servicio para facturación
// =============================================================================

model ProductService {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre      String
  descripcion String?
  precio      Decimal @db.Decimal(12, 2)
  impuesto    Decimal @default(19) @db.Decimal(5, 2)
  activo      Boolean @default(true)

  @@index([tenantId])
  @@index([tenantId, activo])
  @@map("product_services")
}

// =============================================================================
// INVOICE — Factura de venta (dominio interno, no DIAN aún)
// =============================================================================

model Invoice {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  numero       String
  subtotal     Decimal       @db.Decimal(12, 2)
  impuestos    Decimal       @db.Decimal(12, 2)
  total        Decimal       @db.Decimal(12, 2)
  status       InvoiceStatus @default(DRAFT)
  fechaEmision DateTime      @default(now())

  items InvoiceItem[]

  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@map("invoices")
}

// =============================================================================
// INVOICE ITEM — Línea de detalle de una factura
// =============================================================================

model InvoiceItem {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  productServiceId String?
  descripcion      String
  cantidad         Decimal @db.Decimal(10, 3)
  valorUnitario    Decimal @db.Decimal(12, 2)
  subtotal         Decimal @db.Decimal(12, 2)

  @@index([invoiceId])
  @@map("invoice_items")
}

// =============================================================================
// AUDIT LOG — Registro de auditoría (Fase: Platform Hardening)
// =============================================================================

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  tenantId   String
  userId     String
  action     String
  entityType String
  entityId   String?
  metadata   Json?   @default("{}")

  @@index([tenantId])
  @@index([tenantId, action])
  @@index([tenantId, createdAt])
  @@index([userId])
  @@map("audit_logs")
}

// =============================================================================
// MUNICIPIO DANE — Catálogo de municipios de Colombia
// =============================================================================

model MunicipioDane {
  id           String @id @default(uuid())
  codigo       String @unique
  nombre       String
  departamento String

  // Relaciones
  tenants             Tenant[]
  sedes               Sede[]
  empleadosExpedicion Empleado[]
  terceros            Tercero[]

  @@index([departamento])
  @@index([nombre])
  @@map("municipios_dane")
}

// =============================================================================
// SEDE — Sede o instalación de un operador educativo
// =============================================================================
// Representa una sede física de la organización. Permite clasificar
// contratos y lotes por sede. Un tenant puede tener múltiples sedes.
// =============================================================================

model Sede {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre      String
  direccion   String?
  municipioId String?
  municipio   MunicipioDane? @relation(fields: [municipioId], references: [id])
  activo      Boolean        @default(true)

  // Relaciones
  contratos    Contrato[]
  lotes        LoteContrato[]
  empleados    Empleado[]
  centrosCosto CentroCosto[]
  pilaCentrosTrabajo PilaCentroTrabajo[]

  @@unique([id, tenantId], map: "sedes_id_tenant_key")
  @@index([tenantId, activo])
  @@index([tenantId, municipioId])
  @@map("sedes")
}

// =============================================================================
// CONTRATO — Contrato laboral de un empleado
// =============================================================================
// Representa un contrato generado (individual o parte de un lote).
// Almacena las URLs de los documentos generados en R2.
// Un empleado puede tener múltiples contratos a lo largo del tiempo
// (renovaciones, cambios de cargo, etc.).
// =============================================================================

model Contrato {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id])

  plantillaId String? // Null si fue creado sin plantilla (manual)
  plantilla   Plantilla? @relation(fields: [plantillaId], references: [id])

  loteId String? // Null si fue generado individualmente
  lote   LoteContrato? @relation(fields: [loteId], references: [id])

  sedeId String?
  sede   Sede?   @relation(fields: [sedeId], references: [id])

  // Clasificación contractual confirmada por la resolución precontractual.
  // El contrato la conserva como evidencia histórica; no resuelve nuevos lotes.
  perfilContractualId String?
  perfilContractual   PerfilContractual? @relation(fields: [perfilContractualId], references: [id], onDelete: Restrict)

  // Auto-referencia: contrato anterior que este contrato renueva
  contratoRenovaId String?
  contratoRenova   Contrato?  @relation("ContratoRenovacion", fields: [contratoRenovaId], references: [id])
  renovaciones     Contrato[] @relation("ContratoRenovacion")

  // Datos del contrato
  tipo        ContratoTipo
  estado      ContratoEstado @default(VIGENTE)
  fechaInicio DateTime
  // Año contractual derivado de fechaInicio. Es nullable solo para conservar
  // contratos históricos duplicados que existieran antes de la regla anual.
  anioContrato Int?
  fechaFin    DateTime? // Null para contratos indefinidos
  cargo       String // Snapshot del cargo al momento del contrato
  salario     Decimal        @db.Decimal(12, 2) // Snapshot del salario

  // Campos adicionales Colombia expansion
  fechaFinPeriodoPrueba DateTime?
  plantillaVersion      String?
  claseRiesgoArl        Int? // Clase de riesgo ARL: 1=mínimo … 5=máximo (Decreto 1072/2015)

  // Documentos generados — URLs en R2
  pdfKey  String? // {tenantId}/contratos/{id}/contrato.pdf
  docxKey String? // {tenantId}/contratos/{id}/contrato.docx

  // Snapshot de variables usadas en la generación
  // Preserva los valores exactos usados aunque el empleado cambie después
  variablesSnapshot Json @default("{}")

  // Relaciones
  alertas            Alerta[]
  expedienteDocs     ExpedienteDoc[]
  generatedDocuments GeneratedDocument[]
  payrollSnapshots   PayrollSnapshot[]

  @@index([tenantId, estado])
  @@index([tenantId, empleadoId])
  @@index([tenantId, fechaFin]) // Crítico para el cron de alertas
  @@index([tenantId, loteId])
  @@index([tenantId, tipo])
  @@index([tenantId, sedeId])
  @@index([tenantId, perfilContractualId])
  @@unique([loteId, empleadoId])
  @@unique([tenantId, empleadoId, anioContrato], map: "contratos_tenantId_empleadoId_anioContrato_key")
  @@map("contratos")
}

// =============================================================================
// PERFIL CONTRACTUAL — Catálogo administrable por tenant
// =============================================================================
// Clasifica explícitamente un vínculo contractual sin depender de Cargo. La
// relación con documentos se incorpora en una fase posterior; este catálogo no
// participa en la generación, selección de plantillas ni procesamiento actual.
// =============================================================================

model PerfilContractual {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  codigo      String
  nombre      String
  descripcion String?
  activo      Boolean @default(true)

  contratos        Contrato[]
  vinculosLaborales VinculoLaboral[]
  configuracionesDocumentales ConfiguracionDocumentalPerfil[]

  @@unique([tenantId, codigo])
  @@index([tenantId, activo])
  @@index([tenantId, nombre])
  @@map("perfiles_contractuales")
}

// =============================================================================
// VINCULO LABORAL — Fuente precontractual del perfil contractual
// =============================================================================
// Representa la clasificación vigente del proceso laboral de un empleado antes
// de generar un contrato. Produce los snapshots del plan confirmado; la
// generación posterior usa esos snapshots y no vuelve a consultar el vínculo.
// =============================================================================

model VinculoLaboral {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Restrict)

  perfilContractualId String
  perfilContractual   PerfilContractual @relation(fields: [perfilContractualId], references: [id], onDelete: Restrict)

  vigenteDesde DateTime  @db.Date
  vigenteHasta DateTime? @db.Date
  activo        Boolean  @default(true)

  @@index([tenantId, empleadoId, activo])
  @@index([tenantId, perfilContractualId])
  @@map("vinculos_laborales")
}

// Configuración pre-resolución. No se consulta todavía durante la generación.
model ConfiguracionDocumentalPerfil {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  perfilContractualId String
  perfilContractual   PerfilContractual @relation(fields: [perfilContractualId], references: [id], onDelete: Restrict)

  tipoDocumental DocumentTemplateType

  plantillaId String
  plantilla   DocumentTemplate @relation(fields: [plantillaId], references: [id], onDelete: Restrict)

  vigenteDesde DateTime  @db.Date
  vigenteHasta DateTime? @db.Date
  activo        Boolean  @default(true)

  @@index([tenantId, perfilContractualId, tipoDocumental, activo])
  @@index([tenantId, plantillaId])
  @@map("configuraciones_documentales_perfil")
}

model BatchDocumentGenerationPlan {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loteId   String
  lote     LoteContrato @relation(fields: [loteId], references: [id], onDelete: Restrict)
  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Restrict)
  tipoDocumental DocumentTemplateType
  fechaProceso DateTime @db.Date
  confirmadoAt DateTime @default(now())
  vinculoLaboralId String
  perfilContractualId String
  configuracionDocumentalPerfilId String
  plantillaId String
  perfilSnapshot Json
  configuracionSnapshot Json
  plantillaSnapshot Json
  empleadoSnapshot Json?
  contratoSnapshot Json?
  motivoResolucion String
  formatoVersion Int @default(1)
  resueltoAt DateTime
  estado BatchDocumentGenerationPlanStatus @default(CONFIRMADO)

  @@unique([loteId, empleadoId, tipoDocumental])
  @@index([tenantId, loteId, estado])
  @@map("batch_document_generation_plans")
}

model BatchDocumentGenerationExclusion {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loteId   String
  lote     LoteContrato @relation(fields: [loteId], references: [id], onDelete: Restrict)

  // Se conserva como valor libre porque un empleado seleccionado puede no
  // existir o no pertenecer ya al tenant en la fecha de evaluación.
  empleadoId String
  tipoDocumental DocumentTemplateType
  fechaEvaluacion DateTime @db.Date
  motivoBloqueo String
  detalle Json?

  @@unique([loteId, empleadoId, tipoDocumental])
  @@index([tenantId, loteId])
  @@map("batch_document_generation_exclusions")
}

// =============================================================================
// LOTE CONTRATO — Proceso de generación masiva de contratos
// =============================================================================
// Representa un job de generación masiva procesado por BullMQ.
// El cliente crea el lote → recibe el loteId → consulta el progreso
// → descarga el ZIP cuando el estado es COMPLETADO.
// Los campos `procesados` y `fallidos` se actualizan en tiempo real.
// =============================================================================

model LoteContrato {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  documentTemplateId String?
  documentTemplate   DocumentTemplate? @relation(fields: [documentTemplateId], references: [id])

  sedeId String?
  sede   Sede?   @relation(fields: [sedeId], references: [id])

  creadoPorId String?
  creadoPor   User?   @relation(fields: [creadoPorId], references: [id])

  // Metadata del lote
  nombreLote          String?
  proposito           LoteProposito?
  tipoContrato        ContratoTipo?
  fechaInicioContrato DateTime?
  fechaFinContrato    DateTime?

  // Estado del procesamiento
  estado     LoteEstado @default(PENDIENTE)
  total      Int // Total de contratos a generar
  procesados Int        @default(0) // Generados exitosamente
  fallidos   Int        @default(0) // Fallaron en la generación

  // Tiempos de procesamiento
  iniciadoAt   DateTime?
  completadoAt DateTime?

  // Resultado
  zipKey     String? // {tenantId}/lotes/{id}/contratos.zip
  erroresLog Json?   @default("[]") // Array de { empleadoId, cedula, error }

  // Parámetros del lote (snapshot de la configuración al momento de crear)
  configuracion Json @default("{}") // fechaInicio, fechaFin, tipo, etc.

  // Relaciones
  contratos Contrato[]
  batchDocumentGenerationPlans BatchDocumentGenerationPlan[]
  batchDocumentGenerationExclusions BatchDocumentGenerationExclusion[]

  @@index([tenantId, estado])
  @@index([tenantId, createdAt])
  @@map("lotes_contrato")
}

// =============================================================================
// EXPEDIENTE DOC — Documento del expediente digital de un empleado
// =============================================================================
// Cada fila es una revisión inmutable almacenada dentro del expediente de un
// empleado. La familia documental agrupa revisiones del mismo acto; la
// categoría pertenece a la familia y no puede cambiar entre revisiones.
// =============================================================================

model ExpedienteDocFamily {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Restrict)

  categoria   ExpedienteCategoria
  nombre      String
  descripcion String?

  revisiones ExpedienteDoc[]

  @@index([tenantId, empleadoId])
  @@index([tenantId, empleadoId, categoria])
  @@map("expediente_doc_families")
}

model ExpedienteDoc {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id])

  familiaId String
  familia   ExpedienteDocFamily @relation(fields: [familiaId], references: [id], onDelete: Restrict)

  reemplazaId String? @unique
  reemplaza ExpedienteDoc? @relation("ExpedienteDocRevision", fields: [reemplazaId], references: [id], onDelete: Restrict)
  reemplazadoPor ExpedienteDoc? @relation("ExpedienteDocRevision")

  contratoId String?
  contrato   Contrato? @relation(fields: [contratoId], references: [id])

  generatedDocumentId String?
  generatedDocument   GeneratedDocument? @relation(fields: [generatedDocumentId], references: [id])

  servicePremiumLineId String?             @unique
  servicePremiumLine   ServicePremiumLine? @relation("ServicePremiumDocument", fields: [servicePremiumLineId, tenantId], references: [id, tenantId], onDelete: Restrict)

  // Clasificación del documento
  categoria   ExpedienteCategoria
  nombre      String // Nombre original del archivo
  descripcion String?
  version     Int                 @default(1) // Versión dentro de una familia documental
  vigente     Boolean             @default(true) // Solo una revisión vigente por familia

  // Fechas de vigencia del documento
  fechaDocumento     DateTime?
  fechaVencimiento   DateTime?
  requiereRenovacion Boolean?

  // Almacenamiento
  // Ruta: {tenantId}/expediente/{empleadoId}/{categoria}/{familiaId}_v{version}_{documentId}.{ext}
  storageKey  String
  mimeType    String // application/pdf, image/jpeg, etc.
  tamanoBytes Int

  // Trazabilidad
  subidoPorId     String? // userId de quien subió el archivo
  subidoPorNombre String? // Snapshot del nombre por si el usuario se elimina

  alerts Alert[]

  @@index([tenantId, empleadoId])
  @@index([tenantId, empleadoId, categoria])
  @@index([tenantId, categoria])
  @@index([tenantId, familiaId, vigente])
  @@unique([familiaId, version])
  @@unique([servicePremiumLineId, tenantId])
  @@map("expediente_docs")
}

// =============================================================================
// ALERTA — Notificación de vencimiento de contrato
// =============================================================================
// El scheduler diario evalúa todos los contratos VIGENTES con fechaFin
// en los próximos 30 días y crea registros de Alerta.
// La combinación única (contratoId, diasAnticipacion) evita alertas duplicadas.
// El estado ENVIADA confirma que el correo salió exitosamente.
// =============================================================================

model Alerta {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  contratoId String
  contrato   Contrato @relation(fields: [contratoId], references: [id])

  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id])

  tipo             AlertaTipo
  estado           AlertaEstado @default(PENDIENTE)
  diasAnticipacion Int // 30, 15 o 7 días antes del vencimiento

  // Resultado del envío
  enviadaAt    DateTime?
  destinatario String? // Email al que se envió la alerta
  errorMensaje String? // Detalle del error si estado = FALLIDA

  // Evita crear la misma alerta dos veces para el mismo contrato y anticipación
  @@unique([contratoId, diasAnticipacion])
  @@index([tenantId, estado])
  @@index([tenantId, tipo])
  @@index([tenantId, createdAt])
  @@map("alertas")
}

// =============================================================================
// CLIENTE FE — Cliente para facturación electrónica
// =============================================================================
// Representa a quien se le emiten las facturas electrónicas.
// Es independiente del módulo de Empleados — son entidades separadas.
// Almacena los datos fiscales necesarios para el XML de la DIAN.
// =============================================================================

model ClienteFE {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Datos fiscales
  razonSocial   String
  nit           String // NIT o cédula del cliente
  digitoVerif   String?
  tipoDocumento String           @default("NIT") // NIT, CC, CE
  regimen       ClienteFERegimen @default(COMUN)

  // Datos de contacto
  email        String? // Para envío automático de facturas
  telefono     String?
  direccion    String?
  ciudad       String?
  departamento String?

  activo Boolean @default(true)

  // Relaciones
  facturas Factura[]

  @@unique([tenantId, nit])
  @@index([tenantId, activo])
  @@index([tenantId, razonSocial])
  @@index([tenantId, deletedAt])
  @@map("clientes_fe")
}

// =============================================================================
// PRODUCTO — Producto o servicio para facturación electrónica
// =============================================================================
// Catálogo de productos y servicios que el tenant puede facturar.
// Incluye código de la DIAN (código estándar de producto/servicio),
// descripción, precio base y tarifa de IVA.
// =============================================================================

model Producto {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  codigo       String // Código interno del tenant
  codigoDIAN   String? // Código estándar DIAN (opcional)
  nombre       String
  descripcion  String?
  precioBase   Decimal      @db.Decimal(12, 2)
  impuesto     ImpuestoTipo @default(IVA_19)
  unidadMedida String       @default("94") // Código DIAN de unidad (94 = Unidad)
  activo       Boolean      @default(true)

  // Relaciones
  items ItemFactura[]

  @@unique([tenantId, codigo])
  @@index([tenantId, activo])
  @@index([tenantId, nombre])
  @@map("productos")
}

// =============================================================================
// FACTURA — Documento de facturación electrónica
// =============================================================================
// Representa una factura electrónica, nota crédito o nota débito
// transmitida a la DIAN vía Matías API.
// El XML firmado se almacena en R2 permanentemente (obligación legal).
// El estado sigue el ciclo: BORRADOR → ENVIANDO → ACEPTADA | RECHAZADA
// =============================================================================

model Factura {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  clienteId String
  cliente   ClienteFE @relation(fields: [clienteId], references: [id])

  // Numeración
  tipo    FacturaTipo   @default(FACTURA_VENTA)
  prefijo String? // Prefijo de la resolución DIAN
  numero  Int // Número secuencial dentro del prefijo
  estado  FacturaEstado @default(BORRADOR)

  // Fechas
  fechaEmision     DateTime  @default(now())
  fechaVencimiento DateTime? // Para control de cartera (no DIAN)

  // Totales calculados y almacenados (desnormalización intencional)
  subtotal Decimal @db.Decimal(12, 2)
  totalIva Decimal @db.Decimal(12, 2)
  total    Decimal @db.Decimal(12, 2)

  // Respuesta DIAN vía Matías API
  matiasId      String? // ID del documento en Matías API
  cufe          String? // Código Único de Facturación Electrónica
  qrCode        String? // Contenido del QR para representación gráfica
  dianRespuesta String? // Mensaje de respuesta de la DIAN
  dianFecha     DateTime? // Fecha de respuesta de la DIAN
  reintentos    Int       @default(0) // Número de intentos de transmisión

  // Almacenamiento en R2
  xmlKey String? // {tenantId}/facturacion/{id}/factura.xml
  pdfKey String? // {tenantId}/facturacion/{id}/factura.pdf

  // Notas y referencia para NC/ND
  notas           String?
  facturaOrigenId String? // Para NC/ND: factura que origina el documento
  facturaOrigen   Factura?  @relation("FacturaReferencia", fields: [facturaOrigenId], references: [id])
  notasEmitidas   Factura[] @relation("FacturaReferencia")

  // Relaciones
  items ItemFactura[]

  @@unique([tenantId, prefijo, numero])
  @@index([tenantId, estado])
  @@index([tenantId, clienteId])
  @@index([tenantId, fechaEmision])
  @@index([tenantId, tipo])
  @@index([tenantId, cufe])
  @@map("facturas")
}

// =============================================================================
// ITEM FACTURA — Línea de detalle de una factura
// =============================================================================
// Cada línea de la factura referencia un Producto del catálogo.
// Los valores de precio y descripción son snapshots del momento
// de la facturación — si el producto cambia después, la factura
// conserva los valores originales (requisito legal).
// =============================================================================

model ItemFactura {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  facturaId String
  factura   Factura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  productoId String? // Null si el ítem fue ingresado manualmente
  producto   Producto? @relation(fields: [productoId], references: [id])

  // Snapshot de los valores al momento de facturar
  codigoDIAN     String?
  descripcion    String // Copia de producto.nombre al facturar
  cantidad       Decimal      @db.Decimal(10, 3)
  precioUnitario Decimal      @db.Decimal(12, 2)
  impuesto       ImpuestoTipo
  porcentajeIva  Decimal      @db.Decimal(5, 2) // 0, 5 o 19
  subtotal       Decimal      @db.Decimal(12, 2) // cantidad * precioUnitario
  valorIva       Decimal      @db.Decimal(12, 2)
  total          Decimal      @db.Decimal(12, 2) // subtotal + valorIva
  unidadMedida   String       @default("94")

  @@index([facturaId])
  @@map("items_factura")
}

// =============================================================================
// PARAMETRO LEGAL NOMINA — Tarifas y topes legales colombianos por vigencia
// =============================================================================
// Una fila = un bloque de parámetros vigentes para un rango de fechas.
// tenantId NULL  = default global de plataforma (sembrado en seed).
// tenantId valor = override por tenant (caso raro).
// El PayrollCalculator lee el bloque completo como un snapshot inmutable.
// PayrollRun.parametroLegalId (FK futura, N2A.3) congela qué fila se usó.
// Reproducibilidad: un período cerrado de 2025 se re-explica con tarifas 2025.
// =============================================================================

model ParametroLegalNomina {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Alcance multi-tenant: NULL = global de plataforma, valor = override por tenant
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Vigencia (fechas como Date, sin zona horaria, para evitar corrimientos)
  vigenciaDesde DateTime  @db.Date
  vigenciaHasta DateTime? @db.Date // NULL = vigencia abierta (la más reciente)
  anio          Int // Denormalizado para filtrado humano / admin

  // Salarios de referencia (COP)
  smmlv             Decimal @db.Decimal(14, 2)
  auxilioTransporte Decimal @db.Decimal(14, 2)
  uvt               Decimal @db.Decimal(14, 2) // Reservado: FSP / retención futura

  // Topes IBC expresados en múltiplos de SMMLV
  topeIbcMinSmmlv        Int     @default(1) // Piso IBC = 1 SMMLV
  topeIbcMaxSmmlv        Int     @default(25) // Techo IBC = 25 SMMLV
  umbralAuxilioSmmlv     Decimal @default(2) @db.Decimal(4, 2) // ≤ 2 SMMLV → aplica auxilio
  umbralExoneracionSmmlv Int     @default(10) // Art. 114-1: < 10 SMMLV → exoneración

  // Tarifas empleado (fracción: 0.04 = 4%) — base = IBC
  pctSaludEmpleado   Decimal @db.Decimal(8, 6) // 0.040000
  pctPensionEmpleado Decimal @db.Decimal(8, 6) // 0.040000

  // Tarifas empleador (fracción) — base = IBC o nómina según concepto
  pctSaludEmpleador   Decimal @db.Decimal(8, 6) // 0.085000 (exonerable)
  pctPensionEmpleador Decimal @db.Decimal(8, 6) // 0.120000
  pctCaja             Decimal @db.Decimal(8, 6) // 0.040000 (no exonerable)
  pctIcbf             Decimal @db.Decimal(8, 6) // 0.030000 (exonerable)
  pctSena             Decimal @db.Decimal(8, 6) // 0.020000 (exonerable)

  // ARL — tarifa por clase de riesgo I a V (fracción)
  arlClaseI   Decimal @db.Decimal(8, 6) // 0.00522
  arlClaseII  Decimal @db.Decimal(8, 6) // 0.01044
  arlClaseIII Decimal @db.Decimal(8, 6) // 0.02436
  arlClaseIV  Decimal @db.Decimal(8, 6) // 0.04350
  arlClaseV   Decimal @db.Decimal(8, 6) // 0.06960

  // Factores de provisión prestacional mensual (fracción). Base = salario (+ auxilio
  // en prima/cesantías/intereses; sin auxilio en vacaciones). Versionados por vigencia
  // como el resto de parámetros legales (ADR-002 §9, D3): antes eran constantes en el
  // calculator. Aproximaciones legales colombianas:
  //   Prima de servicios (CST Art. 306): 30/360 ≈ 8.33% mensual.
  //   Cesantías (CST Art. 249): 30/360 ≈ 8.33% mensual.
  //   Intereses sobre cesantías (Ley 52/1975): 12% anual ≈ 1% mensual de la base.
  //   Vacaciones (CST Art. 186): 15/360 ≈ 4.17% mensual.
  factorProvPrima        Decimal @db.Decimal(8, 6) // 0.083300
  factorProvCesantias    Decimal @db.Decimal(8, 6) // 0.083300
  factorProvIntCesantias Decimal @db.Decimal(8, 6) // 0.010000
  factorProvVacaciones   Decimal @db.Decimal(8, 6) // 0.041700

  // FSP — escala progresiva por tramos (Ley 100 Art. 27, Ley 797/2003)
  // Shape: [{ desdeSmmlv: number, hastaSmmlv: number | null, pct: number }]
  // Ejemplo: [{ desdeSmmlv: 4, hastaSmmlv: 16, pct: 0.01 }, { desdeSmmlv: 16, hastaSmmlv: 17, pct: 0.012 }, ...]
  // pct = tasa TOTAL para el tramo (no adicional)
  fspTramos Json

  // Trazabilidad legal del decreto/resolución que fija estos valores
  fuente String? // Ej: "Decreto 2613 de 2024, Art. 1"
  notas  String?

  // Inversa de PayrollRun.parametroLegalId (añadida en N2A.2)
  runs      PayrollRun[]
  snapshots PayrollSnapshot[]

  @@unique([tenantId, vigenciaDesde])
  @@index([tenantId, vigenciaDesde, vigenciaHasta])
  @@index([tenantId, anio])
  @@map("parametros_legales_nomina")
}

// =============================================================================
// MOTOR CONTABLE — ADR-001 · FASE C0 (CATÁLOGOS)
// =============================================================================
// Alcance estricto de C0: catálogos + provisioning + CRUD administrativo.
//   - Sin ComprobanteContable ni MovimientoContable (C1).
//   - Sin saldos almacenados: los saldos se DERIVAN de movimientos (C2).
//   - Sin lógica contable, posteo, numeración ni cálculo en estos modelos.
// Convenciones del repo: UUID, tenantId como 1ª columna de cada índice,
// soft delete (deletedAt) donde aplica, snake_case plural vía @@map.
// =============================================================================

// =============================================================================
// CUENTA CONTABLE — Plan de cuentas (árbol PUC)
// =============================================================================
// tenantId NULL  = plantilla PUC global de plataforma (sembrada en seed).
// tenantId valor = cuenta perteneciente a un tenant (clon de la plantilla).
// El clonado por tenant lo realiza AccountingProvisioningService (explícito,
// bajo demanda). El catálogo global nunca recibe movimientos (ADR §2.4).
// SIN columna de saldo: la verdad son los movimientos (C1), el saldo se deriva.
// =============================================================================

model CuentaContable {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete: preserva integridad histórica

  // tenantId NULL = plantilla global; valor = cuenta del tenant
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  codigo        String // Código PUC: '1', '11', '1105', '110505'
  nombre        String
  claseContable ClaseContable
  naturaleza    NaturalezaContable
  nivel         Int // 1 clase, 2 grupo, 3 cuenta, 4 subcuenta, 5 auxiliar

  // Árbol PUC (auto-referencia). NoAction evita ciclos de borrado en Postgres;
  // las cuentas nunca se borran en duro (soft delete).
  cuentaPadreId String?
  cuentaPadre   CuentaContable?  @relation("ArbolPUC", fields: [cuentaPadreId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subcuentas    CuentaContable[] @relation("ArbolPUC")

  // Banderas de control. En C0 solo se persisten; las hacen cumplir las
  // invariantes I5/I6 del service de contabilización en C1 (no aquí).
  imputable           Boolean @default(false) // hoja que recibe movimiento vs. cuenta agrupadora
  esCuentaSistema     Boolean @default(false) // reservada de plataforma: el tenant no la borra/edita
  requiereTercero     Boolean @default(false)
  requiereCentroCosto Boolean @default(false)
  requiereBase        Boolean @default(false) // exige baseGravable en la línea (C1)
  activa              Boolean @default(true) // estado operativo (I5)

  // Inversas
  sistemaMaps CuentaSistemaMap[]
  movimientos MovimientoContable[]

  // Unicidad por tenant. OJO: con tenantId NULL Postgres trata los NULL como
  // distintos, por lo que este @@unique NO protege la plantilla global; la
  // migración añade un índice único PARCIAL (WHERE tenantId IS NULL) para ello.
  @@unique([tenantId, codigo])
  @@index([tenantId, cuentaPadreId])
  @@index([tenantId, claseContable])
  @@index([tenantId, imputable])
  @@index([tenantId, deletedAt])
  @@map("cuentas_contables")
}

// =============================================================================
// TERCERO — Contraparte contable canónica
// =============================================================================
// Identidad documental única por tenant (tipoDocumento + numeroDocumento).
// Roles por banderas (no tablas por tipo — anti-objetivo ADR §8). Convive con
// Empleado / ClienteFE / Customer SIN fusionarlos (ADR §2.5).
// =============================================================================

model Tercero {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Identidad documental canónica (reusa el enum existente TipoDocIdentidad)
  tipoDocumento      TipoDocIdentidad
  numeroDocumento    String
  digitoVerificacion String? // Dígito de verificación del NIT

  tipoPersona     TipoPersona
  razonSocial     String? // Persona jurídica
  primerNombre    String? // Persona natural
  segundoNombre   String?
  primerApellido  String?
  segundoApellido String?
  nombreComercial String?

  // Roles por banderas
  esCliente              Boolean @default(false)
  esProveedor            Boolean @default(false)
  esEmpleado             Boolean @default(false)
  esEntidadGubernamental Boolean @default(false)
  esBanco                Boolean @default(false)

  // Datos fiscales para información exógena (reservados; sin lógica en C0)
  responsabilidadesFiscales Json    @default("[]") // Códigos DIAN (O-13, O-15, …)
  regimenSimple             Boolean @default(false)
  granContribuyente         Boolean @default(false)

  // Contacto
  email       String?
  telefono    String?
  direccion   String?
  municipioId String?
  municipio   MunicipioDane? @relation(fields: [municipioId], references: [id])

  activo Boolean @default(true)

  // Inversas
  movimientos MovimientoContable[]

  @@unique([tenantId, tipoDocumento, numeroDocumento])
  @@index([tenantId, esCliente])
  @@index([tenantId, esProveedor])
  @@index([tenantId, razonSocial])
  @@index([tenantId, deletedAt])
  @@map("terceros")
}

// =============================================================================
// PERIODO CONTABLE — Unidad de control de cierre
// =============================================================================
// (tenant, anio, mes) único. Ciclo ABIERTO → CERRADO (la reapertura es rara y
// se audita en AuditLog, I9). SIN soft delete: un período no se borra.
// El cierre anual lo resuelve C3 vía comprobante; no requiere columna en C0.
// =============================================================================

model PeriodoContable {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  anio Int
  mes  Int // 1–12

  fechaInicio DateTime @db.Date // Derivadas de (anio, mes); almacenadas para rangos
  fechaFin    DateTime @db.Date

  estado       EstadoPeriodo @default(ABIERTO)
  cerradoAt    DateTime?
  cerradoPorId String? // userId que cerró; el detalle queda en AuditLog (I9)

  // Inversas
  comprobantes ComprobanteContable[]

  @@unique([tenantId, anio, mes])
  @@index([tenantId, estado])
  @@index([tenantId, anio])
  @@map("periodos_contables")
}

// =============================================================================
// CENTRO DE COSTO — Dimensión analítica opcional (catálogo plano)
// =============================================================================
// Arranca mapeado 1:1 con Sede. SIN jerarquía ni prorrateo (anti-objetivo
// ADR §8): no existe padreId.
// =============================================================================

model CentroCosto {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  codigo String
  nombre String

  sedeId String? // Mapeo inicial 1:1 con Sede
  sede   Sede?   @relation(fields: [sedeId], references: [id])

  activo Boolean @default(true)

  // Inversas
  movimientos      MovimientoContable[]
  payrollRuns      PayrollRun[]
  payrollSnapshots PayrollSnapshot[]

  @@unique([tenantId, codigo])
  @@index([tenantId, activo])
  @@index([tenantId, sedeId])
  @@index([tenantId, deletedAt])
  @@map("centros_costo")
}

// =============================================================================
// CUENTA SISTEMA MAP — Lookup puro rol → cuenta
// =============================================================================
// CONTRATO INMUTABLE: esto es un diccionario de IDENTIDAD de cuenta, NO un
// motor de reglas. Resuelve exactamente:
//
//     (tenant, rol) -> cuentaId
//
// PROHIBIDO en fases futuras: condiciones, fórmulas, prioridades, porcentajes,
// reglaJson o cualquier columna con semántica de decisión. La lógica de
// causación (qué cuenta bajo qué circunstancia) vive en los mappers puros de
// cada módulo (calculadoras versionadas y testeadas, como las de nómina), no
// aquí. Un DSL de reglas de causación es anti-objetivo explícito (ADR §8).
//
// `rol` es código de TEXTO estable (no enum de BD), coherente con origenEvento
// (I8): 'IVA_GENERADO', 'SALARIOS_POR_PAGAR', 'BANCO_PRINCIPAL', …
// =============================================================================

model CuentaSistemaMap {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  rol         String // Código de rol estable (texto), p. ej. 'IVA_GENERADO'
  cuentaId    String
  cuenta      CuentaContable @relation(fields: [cuentaId], references: [id])
  descripcion String?
  activo      Boolean        @default(true)

  @@unique([tenantId, rol])
  @@index([tenantId, cuentaId])
  @@map("cuenta_sistema_map")
}

// =============================================================================
// TIPO COMPROBANTE — Catálogo GLOBAL de plataforma
// =============================================================================
// Catálogo puro y global (sin tenantId): las definiciones de tipo (CI, CE, CC,
// FV, NC…) son estándar contable e idénticas entre tenants. NO se clona.
// En C0 es inerte: SIN consecutivos, SIN numeración, SIN lógica. La numeración
// per-tenant (I7) la introduce C1 en una entidad de secuencia separada.
// =============================================================================

model TipoComprobante {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  codigo  String  @unique // 'CI', 'CE', 'CC', 'FV', 'NC', 'ND', 'NOM', 'AJ'
  nombre  String
  prefijo String?
  activo  Boolean @default(true)

  // Inversas (C1 — el consecutivo y los comprobantes son por tenant)
  comprobantes ComprobanteContable[]
  secuencias   SecuenciaComprobante[]

  @@index([activo])
  @@map("tipos_comprobante")
}

// =============================================================================
// COMPROBANTE CONTABLE — Encabezado del asiento (ADR-001 §4, §5)
// =============================================================================
// Fase C1.1 — Ledger Core. Append-only: sin deletedAt, sin UPDATE/DELETE tras
// CONTABILIZADO (I2); la corrección es reverso, no edición. `numero` es NULL
// en BORRADOR y se asigna solo al contabilizar (I7), vía SecuenciaComprobante
// en la misma transacción. Solo COP en C1: sin moneda/tasaCambio.
// =============================================================================

model ComprobanteContable {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tipoComprobanteId String
  tipoComprobante   TipoComprobante @relation(fields: [tipoComprobanteId], references: [id])

  periodoId String
  periodo   PeriodoContable @relation(fields: [periodoId], references: [id])

  numero Int? // Asignado al contabilizar (I7); NULL en BORRADOR

  fecha    DateTime @db.Date
  concepto String

  estado EstadoComprobante @default(BORRADOR)

  totalDebito  Decimal @default(0) @db.Decimal(14, 2)
  totalCredito Decimal @default(0) @db.Decimal(14, 2)

  // Idempotencia de origen (I8). Texto/UUID sueltos — NUNCA FK a nómina ni
  // facturación: el núcleo contable no importa módulos fuente (ADR §2.2).
  // Todos NULL (nota manual) o todos NOT NULL — CHECK en la migración.
  origenTipo   String?
  origenId     String?
  origenEvento String? // 'CAUSACION', 'PAGO', 'RECAUDO', 'REVERSO_CAUSACION', …

  // Reverso: el original nunca se toca (I2); el reverso apunta a él.
  // NoAction/NoAction: un comprobante contabilizado no se borra ni actualiza
  // en cascada — la reversión es un registro nuevo, no una mutación.
  reversaAId String?
  reversaA   ComprobanteContable?  @relation("Reverso", fields: [reversaAId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reversos   ComprobanteContable[] @relation("Reverso")

  usuarioId       String // userId que registra el comprobante
  contabilizadoAt DateTime?

  // Inversas
  movimientos MovimientoContable[]

  // Índices de consulta: se difieren a C2 (Reportes). Los índices únicos
  // parciales de I7 (consecutivo) e I8 (idempotencia) viven en la migración SQL.
  @@map("comprobantes_contables")
}

// =============================================================================
// MOVIMIENTO CONTABLE — Línea débito/crédito (ADR-001 §4)
// =============================================================================
// Append-only: sin deletedAt. `linea` fija el orden dentro del comprobante y
// es único junto a comprobanteId. Exactamente uno de debito/credito > 0 (I4)
// — CHECK en la migración. `baseGravable` reservado para I6 (requiereBase).
// =============================================================================

model MovimientoContable {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  comprobanteId String
  comprobante   ComprobanteContable @relation(fields: [comprobanteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  linea Int // Orden dentro del comprobante; único junto a comprobanteId

  cuentaId String
  cuenta   CuentaContable @relation(fields: [cuentaId], references: [id])

  terceroId String?
  tercero   Tercero? @relation(fields: [terceroId], references: [id])

  centroCostoId String?
  centroCosto   CentroCosto? @relation(fields: [centroCostoId], references: [id])

  debito  Decimal @default(0) @db.Decimal(14, 2)
  credito Decimal @default(0) @db.Decimal(14, 2)

  baseGravable Decimal? @db.Decimal(14, 2) // Base para I6 (requiereBase)
  descripcion  String?

  // Índices de consulta diferidos a C2. Se conserva solo la restricción de
  // integridad de orden de línea (no es optimización).
  @@unique([comprobanteId, linea])
  @@map("movimientos_contables")
}

// =============================================================================
// SECUENCIA COMPROBANTE — Consecutivo por (tenant, tipo) (ADR-001 I7)
// =============================================================================
// Contador puro: sin id artificial, la clave natural (tenantId,
// tipoComprobanteId) es suficiente y evita un índice único redundante.
// Se incrementa dentro de la misma transacción que contabiliza (I7).
// =============================================================================

model SecuenciaComprobante {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  tipoComprobanteId String
  tipoComprobante   TipoComprobante @relation(fields: [tipoComprobanteId], references: [id])

  ultimoNumero Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@id([tenantId, tipoComprobanteId])
  @@map("secuencias_comprobante")
}
