// =============================================================================
// ALERT GENERATION RUN — Estado operativo del scheduler (E6.3)
// =============================================================================

model AlertGenerationRun {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  schedulerKey String
  trigger      AlertGenerationRunTrigger @default(SCHEDULED)
  parentRunId  String?
  status       AlertGenerationRunStatus  @default(RUNNING)
