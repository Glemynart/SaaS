// =============================================================================
// LIQUIDATION STATUS — Estado de la liquidación laboral
// =============================================================================

enum LiquidationStatus {
  DRAFT // En elaboración, aún modificable
  APPROVED // Aprobada y congelada — no modificable
  PAID // Pagada — terminal
  VOIDED // Anulada sin pago — terminal
}

// =============================================================================
// LIQUIDATION CONCEPT TYPE — Tipo de concepto en liquidación laboral
// =============================================================================

enum LiquidationConceptType {
  EARNING // Prestación social / devengo: prima, cesantías, intereses, vacaciones, salario pendiente
  PROVISION // Concepto de costo diferido (reservado para extensiones futuras)
}

// =============================================================================
// PAYROLL PERIOD — Período de liquidación de nómina
// =============================================================================

model PayrollPeriod {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre      String
  fechaInicio DateTime
  fechaFin    DateTime
  fechaPrevistaPagoPila DateTime? @db.Date
  status      PayrollPeriodStatus @default(BORRADOR)

  // Actor de la transición a APROBADA (P1/U1): vía flujo de revisión o el
  // alias legado `close` (CALCULADA → APROBADA directo). Nullable: no aplica
  // a estados previos a APROBADA ni a períodos legados backfilleados.
  aprobadoPorId String?
  aprobadoPor   User?     @relation("PayrollPeriodAprobadoPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)
  aprobadoEn    DateTime?

  runs      PayrollRun[]
  snapshots PayrollSnapshot[]
  corrections PayrollCorrection[]
  novelties PayrollNovelty[]
  pilaEvents PayrollPilaEvent[]
  blocks    PayrollBlock[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("payroll_periods")
}

// =============================================================================
// PAYROLL RUN — Liquidación individual de un empleado en un período
// =============================================================================

model PayrollRun {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])

  employeeId String
  employee   Empleado @relation(fields: [employeeId], references: [id])

  centroCostoId String?
  centroCosto   CentroCosto? @relation(fields: [centroCostoId], references: [id])

  totalDevengos       Decimal  @db.Decimal(12, 2)
  totalDeducciones    Decimal  @db.Decimal(12, 2)
  netoPagar           Decimal  @db.Decimal(12, 2)
  salarioBaseSnapshot Decimal? @db.Decimal(12, 2)

  // N2A — snapshot de cálculo colombiano (nullable: runs N1 quedan en NULL)
  ibc                    Decimal? @db.Decimal(14, 2) // Base de cotización liquidada
  auxilioTransporte      Decimal? @db.Decimal(14, 2) // Devengo separado, no es IBC
  totalAportesPatronales Decimal? @db.Decimal(14, 2) // Σ EMPLOYER_CONTRIBUTION
  costoTotalEmpleador    Decimal? @db.Decimal(14, 2) // totalDevengos + totalAportesPatronales
  parametroLegalId       String? // FK → vigencia de parámetros usada

  // N2B — snapshot de provisiones prestacionales (nullable: runs N1/N2A quedan en NULL)
  totalProvisiones Decimal? @db.Decimal(14, 2) // Σ PROVISION (prima, cesantías, intereses, vacaciones)

  // U3 — huella técnica de los insumos normalizados usados por el cálculo.
  calculationTrace Json?

  // Datos declarados para PILA capturados al calcular; se promueven al snapshot
  // únicamente al aprobar. No se reconstruyen para runs históricos.
  pilaSource Json?

  parametroLegal ParametroLegalNomina? @relation(fields: [parametroLegalId], references: [id], onDelete: Restrict)

  concepts PayrollConcept[]
  snapshot PayrollSnapshot?

  @@unique([tenantId, payrollPeriodId, employeeId])
  @@index([tenantId])
  @@index([tenantId, payrollPeriodId])
  @@index([tenantId, employeeId])
  @@index([parametroLegalId])
  @@map("payroll_runs")
}

// =============================================================================
// PAYROLL CONCEPT — Concepto individual dentro de una liquidación
// =============================================================================

model PayrollConcept {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  payrollRunId String
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id])

  tipo   PayrollConceptType
  nombre String
  valor  Decimal            @db.Decimal(12, 2)

  // N2A — trazabilidad del cálculo (nullable: conceptos N1 quedan en NULL)
  codigo String? // Código estable del catálogo: SALARIO_BASE, SALUD_EMP, ARL, etc.
  base   Decimal? @db.Decimal(14, 2) // Base sobre la que se calculó (IBC, nómina)
  factor Decimal? @db.Decimal(8, 6) // Tarifa aplicada (0.04, 0.085, tarifa ARL…)

  @@index([payrollRunId])
  @@map("payroll_concepts")
}

// =============================================================================
// PAYROLL SNAPSHOT — Evidencia inmutable de una liquidación aprobada
// =============================================================================

model PayrollSnapshot {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payrollRunId String     @unique
  payrollRun   PayrollRun @relation(fields: [payrollRunId], references: [id], onDelete: Restrict)

  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)

  employeeId String
  employee   Empleado @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  contratoId String?
  contrato   Contrato? @relation(fields: [contratoId], references: [id], onDelete: Restrict)

  parametroLegalId String?
  parametroLegal   ParametroLegalNomina? @relation(fields: [parametroLegalId], references: [id], onDelete: Restrict)

  centroCostoId String?
  centroCosto   CentroCosto? @relation(fields: [centroCostoId], references: [id], onDelete: Restrict)

  aprobadoPorId String?
  aprobadoPor   User?   @relation("PayrollSnapshotAprobadoPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)

  estadoPeriodo  PayrollPeriodStatus
  origen         String
  payloadVersion Int                 @default(1)
  payload        Json
  // Paquete fuente inmutable para PILA, separado del payload consumido por
  // Prima y Ledger. Los snapshots históricos permanecen en NULL.
  pilaPayloadVersion Int?
  pilaPayload        Json?

  @@index([tenantId])
  @@index([tenantId, payrollPeriodId])
  @@index([tenantId, employeeId])
  @@index([tenantId, createdAt])
  @@index([parametroLegalId])
  @@index([centroCostoId])
  @@map("payroll_snapshots")
}

// =============================================================================
// PAYROLL CORRECTION — Acto de corrección post-aprobación sobre un período
// =============================================================================

model PayrollCorrection {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Restrict)

  status      PayrollCorrectionStatus @default(BORRADOR)
  descripcion String

  // ACC-14A — Intención tipada y materialización inmutable de la corrección.
  // Nullable para preservar las correcciones P1.5 existentes: una de ellas sin
  // intención/materialización no es elegible para ajustes posteriores.
  intentVersion          Int?
  intent                 Json?
  materializationVersion Int?
  materialization        Json?
  materializedAt         DateTime?

  @@index([tenantId])
  @@index([tenantId, payrollPeriodId])
  @@index([tenantId, payrollPeriodId, status])
  @@map("payroll_corrections")
}

// =============================================================================
// SERVICE PREMIUM — Prima semestral calculada desde nóminas aprobadas
// =============================================================================

model ServicePremiumBatch {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  anio                 Int
  semestre             Int
  version              Int                       @default(1)
  formulaVersion       Int
  status               ServicePremiumBatchStatus @default(BORRADOR)
  createdById          String
  correctionReason     String?
  approvedById         String?
  approvedAt           DateTime?
  completedAt          DateTime?
  processingLeaseOwner String?
  processingLeaseUntil DateTime?
  lastErrorCode        String?

  supersedesBatchId String?
  supersedesBatch   ServicePremiumBatch?  @relation("ServicePremiumBatchCorrection", fields: [supersedesBatchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  correctedBatches  ServicePremiumBatch[] @relation("ServicePremiumBatchCorrection")
  lines             ServicePremiumLine[]

  @@unique([id, tenantId])
  @@unique([tenantId, anio, semestre, version])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, anio, semestre])
  @@map("service_premium_batches")
}

model ServicePremiumLine {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  batchId    String
  batch      ServicePremiumBatch @relation(fields: [batchId, tenantId], references: [id, tenantId], onDelete: Restrict)
  employeeId String
  employee   Empleado            @relation(fields: [employeeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  status             ServicePremiumLineStatus
  snapshot           Json
  sourceFingerprint  String?
  salaryBase         Decimal?                 @db.Decimal(14, 2)
  variableSalary     Decimal?                 @db.Decimal(14, 2)
  transportAllowance Decimal?                 @db.Decimal(14, 2)
  serviceDays360     Int?
  amount             Decimal?                 @db.Decimal(14, 2)
  blockReason        String?
  processingAttempts Int                      @default(0)
  lastErrorCode      String?
  documentStorageKey String?
  documentSizeBytes  Int?
  documentSha256     String?

  expedienteDoc ExpedienteDoc? @relation("ServicePremiumDocument")

  @@unique([id, tenantId])
  @@unique([tenantId, batchId, employeeId])
  @@index([tenantId, batchId, status])
  @@index([tenantId, employeeId, createdAt])
  @@map("service_premium_lines")
}

// =============================================================================
// PAYROLL BLOCK — Bloqueo funcional de liquidación para empleado/período
// =============================================================================

model PayrollBlock {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Empleado @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  code    String
  message String
  status  PayrollBlockStatus @default(ACTIVE)

  detectedAt DateTime  @default(now())
  resolvedAt DateTime?
  excludedAt DateTime?

  excludedById    String?
  excludedBy      User?   @relation("PayrollBlockExcludedBy", fields: [excludedById], references: [id], onDelete: SetNull)
  exclusionReason String?

  @@unique([tenantId, payrollPeriodId, employeeId, code])
  @@index([tenantId])
  @@index([tenantId, payrollPeriodId])
  @@index([tenantId, payrollPeriodId, status])
  @@index([tenantId, employeeId])
  @@index([excludedById])
  @@map("payroll_blocks")
}

// =============================================================================
// PAYROLL NOVELTY — Novedad de nómina por empleado
// =============================================================================

model PayrollNovelty {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])

  employeeId String
  employee   Empleado @relation(fields: [employeeId], references: [id])

  tipo        PayrollNoveltyType
  descripcion String?
  fecha       DateTime
  valor       Decimal?           @db.Decimal(12, 2)

  @@index([tenantId])
  @@index([tenantId, payrollPeriodId])
  @@index([tenantId, employeeId])
  @@index([tenantId, tipo])
  @@map("payroll_novelties")
}

// =============================================================================
// PAYROLL PILA EVENT — Novedad explícita para reporte PILA (ADR-013)
// =============================================================================

model PayrollPilaEvent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payrollPeriodId String
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Empleado @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  codigo     PilaEventCode
  fechaInicio DateTime @db.Date
  fechaFin    DateTime? @db.Date
  dias        Int?

  @@index([tenantId, payrollPeriodId, employeeId])
  @@index([tenantId, payrollPeriodId, codigo])
  @@map("payroll_pila_events")
}

// =============================================================================
// LIQUIDATION — Liquidación laboral de un empleado (N2D)
// =============================================================================
// Dominio propio: no depende de PayrollRun ni PayrollPeriod.
// El calculator (N2D.1) recalcula desde fechas y bases legales reales;
// las provisiones N2B son costo contable y nunca se leen aquí.
// =============================================================================

model Liquidation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id])

  // Fecha de retiro usada en el cálculo (snapshot; no mutable tras FINALIZED)
  fechaRetiro DateTime

  status LiquidationStatus @default(DRAFT)

  // Días comerciales liquidados (convención 30/360, extremo exclusivo)
  diasLiquidados Int

  // Totales en peso entero
  totalDevengado   Decimal @db.Decimal(14, 2)
  totalProvisiones Decimal @db.Decimal(14, 2)
  totalLiquidacion Decimal @db.Decimal(14, 2)

  concepts LiquidationConcept[]

  @@index([tenantId])
  @@index([empleadoId])
  @@index([status])
  @@map("liquidations")
}

// =============================================================================
// LIQUIDATION CONCEPT — Concepto individual dentro de una liquidación
// =============================================================================

model LiquidationConcept {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  liquidationId String
  liquidation   Liquidation @relation(fields: [liquidationId], references: [id], onDelete: Cascade)

  codigo String // Código estable del catálogo: LIQ_PRIMA, LIQ_CESANTIAS, etc.
  nombre String
  tipo   LiquidationConceptType

  base   Decimal? @db.Decimal(14, 2) // Base monetaria del cálculo
  factor Decimal? @db.Decimal(8, 6) // Factor aplicado (ej. 0.5 = 180 días / 360)
  valor  Decimal  @db.Decimal(14, 2) // Monto en peso entero: roundPeso(base × factor)

  @@index([liquidationId])
  @@index([codigo])
  @@map("liquidation_concepts")
}

// =============================================================================
// CUSTOMER STATUS — Estado del cliente
// =============================================================================

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

// =============================================================================
// INVOICE STATUS — Estado de la factura
// =============================================================================

enum InvoiceStatus {
  DRAFT
  ISSUED
  CANCELLED
}

// =============================================================================
// CUSTOMER — Cliente para facturación
// =============================================================================

model Customer {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  razonSocial String
  nit         String
  email       String?
  telefono    String?
  direccion   String?
  status      CustomerStatus @default(ACTIVE)

  invoices Invoice[]

  @@unique([tenantId, nit])
  @@index([tenantId])
