// =============================================================================
// SCHEMA PRISMA — MVP SaaS Multiempresa
// Contratos · Expediente Digital · Alertas · Facturación Electrónica
// =============================================================================
// Convenciones:
//   - Todos los modelos tienen id UUID, tenantId, createdAt, updatedAt
//   - Todos los índices incluyen tenantId como primera columna
//   - Soft delete (deletedAt) solo en entidades que lo requieren
//   - Enums en PascalCase, valores en UPPER_SNAKE_CASE
//   - Tablas en snake_case plural via @@map
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum Plan {
  STARTER
  PROFESIONAL
  OPERADOR_EDUCATIVO
}

enum UserRole {
  ADMIN
  OPERADOR
  VIEWER
}

enum EmpleadoEstado {
  ACTIVO
  INACTIVO
  SUSPENDIDO
  RETIRADO
}

enum ContratoTipo {
  TERMINO_FIJO
  TERMINO_INDEFINIDO
  OBRA_LABOR
  APRENDIZAJE
  PRESTACION_SERVICIOS
}

enum ContratoEstado {
  VIGENTE
  VENCIDO
  TERMINADO
  RENOVADO
}

enum LoteEstado {
  PENDIENTE
  EN_PROCESO
  COMPLETADO
  COMPLETADO_CON_ERRORES
  FALLIDO
}

enum LoteProposito {
  CONTRATACION
}

enum PlantillaTipo {
  CONTRATO
  PREAVISO
  TERMINACION
  CERTIFICADO
  OTRO
}

enum ExpedienteCategoria {
  CONTRATO
  AFILIACION
  CERTIFICADO
  PRIMA_SERVICIOS
  DOCUMENTO_PERSONAL
  PREAVISO
  TERMINACION
  OTRO
}

enum AlertaTipo {
  CONTRATO_POR_VENCER
  CONTRATO_VENCIDO
}

enum AlertaEstado {
  PENDIENTE
  ENVIADA
  FALLIDA
}

enum ClienteFERegimen {
  SIMPLIFICADO
  COMUN
  GRAN_CONTRIBUYENTE
  NO_RESPONSABLE
}

enum FacturaEstado {
  BORRADOR
  ENVIANDO
  ACEPTADA
  RECHAZADA
  ERROR_TECNICO
}

enum FacturaTipo {
  FACTURA_VENTA
  NOTA_CREDITO
  NOTA_DEBITO
}

enum ImpuestoTipo {
  IVA_0
  IVA_5
  IVA_19
  EXCLUIDO
  EXENTO
}

enum TipoDocIdentidad {
  CC
  CE
  TI
  PA
  NIT
  PEP
  PPT
}

enum TipoSalarioPila {
  X
  F
  V
}

enum JornadaLaboral {
  COMPLETA
  MEDIA
  POR_HORAS
}

enum MotivoRetiro {
  RENUNCIA
  TERMINACION_CONTRATO
  MUTUO_ACUERDO
  JUSTA_CAUSA
  FALLECIMIENTO
  OTRO
}

enum ZonaMunicipio {
  URBANA
  RURAL
}

// --- Motor contable ADR-001 · Fase C0 — Catálogos -------------------------

// Naturaleza del saldo de una cuenta del PUC.
enum NaturalezaContable {
  DEBITO
  CREDITO
}

// Clase del Plan Único de Cuentas (PUC, Decreto 2650/1993). El ordinal
// corresponde al primer dígito del código de la cuenta (1..9).
enum ClaseContable {
  ACTIVO // 1
  PASIVO // 2
  PATRIMONIO // 3
  INGRESOS // 4
  GASTOS // 5
  COSTOS_VENTAS // 6
  COSTOS_PRODUCCION // 7
  CUENTAS_ORDEN_DEUDORAS // 8
  CUENTAS_ORDEN_ACREEDORAS // 9
}

// Estado de control de cierre de un período contable.
enum EstadoPeriodo {
  ABIERTO
  CERRADO
}

// Naturaleza jurídica de un tercero (define qué campos de nombre aplican).
enum TipoPersona {
  NATURAL
  JURIDICA
}

// Ciclo de vida del comprobante contable (ADR-001 §5).
// BORRADOR: editable, sin número, no afecta libros.
// CONTABILIZADO: inmutable, numerado, cuadrado (I1). ANULADO: conserva número.
enum EstadoComprobante {
  BORRADOR
  CONTABILIZADO
  ANULADO
}

// =============================================================================
// TENANT — Empresa registrada en la plataforma
// =============================================================================
// Entidad raíz del sistema multiempresa. Todo dato del sistema pertenece a
// exactamente un Tenant. El tenantId es el primer filtro en cada query.
// Un Tenant representa una organización: operador educativo, empresa, etc.
// =============================================================================

model Tenant {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Datos de la organización
  nombre       String
  nit          String  @unique // NIT sin dígito de verificación
  digitoVerif  String // Dígito de verificación del NIT
  razonSocial  String
  direccion    String?
  ciudad       String?
  departamento String?
  telefono     String?
  email        String?
  logoUrl      String? // URL en R2 del logo de la empresa

  // Identidad corporativa — Branding
  representanteLegal    String? // Nombre del representante legal
  firmaRepresentanteUrl String? // URL en R2 de la firma digitalizada

  // Municipio de ubicación principal (Colombia)
  municipioId String?
  municipio   MunicipioDane? @relation(fields: [municipioId], references: [id])

  // Configuración del plan
  plan        Plan      @default(STARTER)
  activo      Boolean   @default(true)
  trialEndsAt DateTime? // Fecha fin del período de prueba

  // Configuración nómina colombiana
  aportesExonerados Boolean @default(false) // Art. 114-1 ET: exoneración salud pat., ICBF, SENA

  // Datos declarados por el aportante para los anexos técnicos PILA.
  // Permanecen nulos hasta que un ADMIN los confirme; no se infieren de branding,
  // sedes operativas ni de los campos de identificación heredados.
  pilaClaseAportante               String?   @db.Char(1)
  pilaTipoDocumentoAportante       String?   @db.VarChar(2)
  pilaNaturalezaJuridica           String?   @db.Char(1)
  pilaTipoPersona                  String?   @db.Char(1)
  pilaFormaPresentacion            String?   @db.Char(1)
  pilaCodigoSucursal               String?   @db.VarChar(10)
  pilaNombreSucursal               String?   @db.VarChar(40)
  pilaCodigoActividadEconomica     String?   @db.VarChar(4)
  pilaCodigoArlAportante           String?   @db.VarChar(16)
  pilaTipoAportante                String?   @db.VarChar(2)
  pilaFax                          String?   @db.VarChar(10)
  pilaRepresentanteTipoDocumento   String?   @db.VarChar(2)
  pilaRepresentanteNumeroDocumento String?   @db.VarChar(16)
  pilaRepresentantePrimerApellido  String?   @db.VarChar(20)
  pilaRepresentanteSegundoApellido String?   @db.VarChar(30)
  pilaRepresentantePrimerNombre    String?   @db.VarChar(20)
  pilaRepresentanteSegundoNombre   String?   @db.VarChar(30)
  pilaFechaMatriculaMercantil      DateTime? @db.Date
  pilaBeneficioLey1429             Boolean?
  pilaBeneficioCcfLey1429          Boolean?
  pilaAportesExoneradosConfirmado  Boolean?
  pilaSinAccionEspecial            Boolean?

  // Configuración DIAN para facturación electrónica
  // Estos campos se completan si el tenant usa el módulo FE
  feActivo          Boolean   @default(false)
  feResolucion      String? // Número de resolución DIAN
  feResolucionFecha DateTime? // Fecha de la resolución
  feResolucionVence DateTime? // Fecha de vencimiento
  fePrefijo         String? // Prefijo autorizado (ej: SETT)
  feRangoDesde      Int? // Número inicial autorizado
  feRangoHasta      Int? // Número final autorizado
  feUltimoNumero    Int? // Último número emitido
  feTecnicoId       String? // ID técnico Matías API
  feTecnicoKey      String? // Clave técnica Matías API

  // Relaciones
  users              User[]
  userInvitations    UserInvitation[]
  empleados          Empleado[]
  afiliacionesSeguridadSocial AfiliacionSeguridadSocial[]
  pilaCentrosTrabajo PilaCentroTrabajo[]
  pilaAsignacionesCentroTrabajo PilaAsignacionCentroTrabajo[]
  sedes              Sede[]
  plantillas         Plantilla[]
  documentTemplates  DocumentTemplate[]
  generatedDocuments GeneratedDocument[]
  expedienteDocFamilies ExpedienteDocFamily[]
  alerts             Alert[]
  alertGenerationRunTenants AlertGenerationRunTenant[]
  payrollPeriods     PayrollPeriod[]
  payrollRuns        PayrollRun[]
  payrollSnapshots     PayrollSnapshot[]
  servicePremiumBatches ServicePremiumBatch[]
  servicePremiumLines   ServicePremiumLine[]
  payrollCorrections   PayrollCorrection[]
  payrollNovelties   PayrollNovelty[]
  payrollPilaEvents   PayrollPilaEvent[]
  payrollBlocks      PayrollBlock[]
  customers          Customer[]
  productServices    ProductService[]
  invoices           Invoice[]
  contratos          Contrato[]
  perfilesContractuales PerfilContractual[]
  configuracionesDocumentalesPerfil ConfiguracionDocumentalPerfil[]
  batchDocumentGenerationPlans BatchDocumentGenerationPlan[]
  batchDocumentGenerationExclusions BatchDocumentGenerationExclusion[]
  vinculosLaborales  VinculoLaboral[]
  lotes              LoteContrato[]
  expedientes        ExpedienteDoc[]
  alertas            Alerta[]
  clientesFE         ClienteFE[]
  productos          Producto[]
  facturas           Factura[]
  parametrosLegales  ParametroLegalNomina[]
  liquidations       Liquidation[]

  // Motor contable C0 (TipoComprobante es catálogo global → sin relación aquí)
  cuentasContables  CuentaContable[]
  terceros          Tercero[]
  periodosContables PeriodoContable[]
  centrosCosto      CentroCosto[]
  cuentaSistemaMaps CuentaSistemaMap[]

  // Motor contable C1 — Ledger
  comprobantesContables ComprobanteContable[]
  movimientosContables  MovimientoContable[]
  secuenciasComprobante SecuenciaComprobante[]

  @@map("tenants")
}

// =============================================================================
// USER — Usuario de la plataforma
// =============================================================================
// Representa a una persona que accede al sistema. Pertenece a un Tenant.
// Un usuario solo puede ver y operar datos de su propio Tenant.
// El rol determina qué operaciones puede realizar (RBAC).
// =============================================================================

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  email        String
  passwordHash String
  nombre       String
  apellido     String
  rol          UserRole @default(OPERADOR)
  activo       Boolean  @default(true)

  // Control de sesión
  lastLoginAt              DateTime?
  refreshTokens            RefreshToken[]
  passwordResetTokens      PasswordResetToken[]
  invitationsCreated       UserInvitation[]     @relation("UserInvitationCreatedBy")
  lotesCreados             LoteContrato[]
  // Actor de aprobación de ProcesoNómina (P1/U1)
  periodosNominaAprobados  PayrollPeriod[]      @relation("PayrollPeriodAprobadoPor")
  snapshotsNominaAprobados PayrollSnapshot[]    @relation("PayrollSnapshotAprobadoPor")
  bloqueosNominaExcluidos  PayrollBlock[]       @relation("PayrollBlockExcludedBy")

  @@unique([tenantId, email]) // Un email es único por empresa, no globalmente
  @@index([tenantId, activo])
  @@index([tenantId, rol])
  @@map("users")
}

// =============================================================================
// REFRESH TOKEN — Control de sesiones activas
// =============================================================================
// Almacena los refresh tokens activos por usuario.
// Permite invalidar sesiones específicas (logout en un dispositivo)
// y detectar refresh token rotation (seguridad contra token theft).
// =============================================================================

model RefreshToken {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String    @unique // Hash SHA-256 del token, nunca el token en texto plano
  expiresAt DateTime
  revokedAt DateTime? // Nulo = activo, fecha = revocado
  userAgent String? // Dispositivo/browser para auditoría
  ipAddress String?

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

// =============================================================================
// PASSWORD RESET TOKEN — Recuperación de contraseña
// =============================================================================
// Token de un solo uso para recuperación de contraseña.
// Sigue el mismo patrón de seguridad que RefreshToken:
// el secreto viaja en el link, solo el hash bcrypt se persiste.
// Un usuario solo puede tener un token pendiente a la vez.
// =============================================================================

model PasswordResetToken {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId String

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@index([tenantId, userId])
  @@map("password_reset_tokens")
}

// =============================================================================
// USER INVITATION — Alta segura de usuarios por enlace de correo
// =============================================================================
// El secreto nunca se persiste. openKey permite una sola invitación pendiente
// por correo y tenant; NULL conserva las invitaciones aceptadas o revocadas sin
// impedir invitaciones futuras.
// =============================================================================

model UserInvitation {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdByUserId String?
  createdBy       User?   @relation("UserInvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  email      String
  nombre     String
  apellido   String
  rol        UserRole
  tokenHash  String   @unique
  expiresAt  DateTime
  lastSentAt DateTime @default(now())
  acceptedAt DateTime?
  revokedAt  DateTime?
  openKey    String?  @default("OPEN")

  @@unique([tenantId, email, openKey])
  @@index([tenantId, openKey, createdAt])
  @@index([expiresAt, acceptedAt, revokedAt])
  @@map("user_invitations")
}

// =============================================================================
// EMPLEADO — Trabajador de la organización
// =============================================================================
// Entidad central del módulo de RRHH. Todos los contratos, expedientes
// y alertas referencian a un Empleado. La cédula es única por tenant.
// Un empleado puede tener múltiples contratos a lo largo del tiempo.
// =============================================================================

model Empleado {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // Soft delete: nunca borrar empleados con historial

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Identificación
  cedula          String
  tipoDocumento   TipoDocIdentidad @default(CC)
  primerNombre    String
  segundoNombre   String?
  primerApellido  String
  segundoApellido String?
  email           String?
  telefono        String?
  fechaNacimiento DateTime?

  // Datos laborales
  cargo        String
  dependencia  String? // Área o departamento
  sede         String? // [LEGACY] Campo texto libre — será reemplazado por sedeId
  sedeId       String? // FK → Sede (relación formal)
  sedeRef      Sede?          @relation(fields: [sedeId], references: [id])
  salario      Decimal        @db.Decimal(12, 2)
  tipoContrato ContratoTipo   @default(TERMINO_FIJO)
  fechaIngreso DateTime
  estado       EmpleadoEstado @default(ACTIVO)

  // Datos de seguridad social (para nómina en V1)
  eps              String?
  arl              String?
  fondoPension     String?
  cajaCompensacion String?

  // Campos Colombia expansion — FASE 2
  municipioExpedicionDocId String?
  municipioExpedicionDoc   MunicipioDane?  @relation(fields: [municipioExpedicionDocId], references: [id])
  salarioIntegral          Boolean         @default(false)
  tipoSalarioPila          TipoSalarioPila?
  jornadaLaboral           JornadaLaboral?
  fechaRetiro              DateTime?
  motivoRetiro             MotivoRetiro?

  // Relaciones
  contratos          Contrato[]
  batchDocumentGenerationPlans BatchDocumentGenerationPlan[]
  vinculosLaborales  VinculoLaboral[]
  generatedDocuments GeneratedDocument[]
  expedienteDocFamilies ExpedienteDocFamily[]
  alerts             Alert[]
  payrollRuns        PayrollRun[]
  payrollSnapshots     PayrollSnapshot[]
  servicePremiumLines  ServicePremiumLine[]
  payrollNovelties     PayrollNovelty[]
  payrollPilaEvents    PayrollPilaEvent[]
  payrollBlocks      PayrollBlock[]
  expediente         ExpedienteDoc[]
  alertas            Alerta[]
  liquidations       Liquidation[]
  afiliacionesSeguridadSocial AfiliacionSeguridadSocial[]
  asignacionesCentroPila PilaAsignacionCentroTrabajo[]

  @@unique([tenantId, cedula])
  @@unique([id, tenantId])
  @@index([tenantId, estado])
  @@index([tenantId, cargo])
  @@index([tenantId, dependencia])
  @@index([tenantId, sedeId])
  @@index([tenantId, deletedAt]) // Para filtrar soft-deleted eficientemente
  @@map("empleados")
}

// =============================================================================
// AFILIACIÓN DE SEGURIDAD SOCIAL — Historia declarada por el empleador
// =============================================================================
// Conserva los códigos y vigencias confirmados manualmente. No se infieren
// desde los campos de texto libre legados de Empleado.
// =============================================================================

model AfiliacionSeguridadSocial {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId, tenantId], references: [id, tenantId], onDelete: Restrict)

  tipoCotizanteCodigo    String  @db.VarChar(2)
  subtipoCotizanteCodigo String? @db.VarChar(2)
  epsCodigo              String  @db.VarChar(6)
  epsNombre              String  @db.VarChar(120)
  fondoPensionCodigo     String  @db.VarChar(6)
  fondoPensionNombre     String  @db.VarChar(120)
  arlCodigo              String  @db.VarChar(6)
  arlNombre              String  @db.VarChar(120)
  arlClaseRiesgo         String  @db.VarChar(1)
  cajaCompensacionCodigo String  @db.VarChar(6)
  cajaCompensacionNombre String  @db.VarChar(120)

  vigenteDesde DateTime  @db.Date
  vigenteHasta DateTime? @db.Date

  versionCaptura          String @default("PILA_AFFILIATION_CAPTURE_V1") @map("formatoNormativoVersion") @db.VarChar(32)
  registradoPorId         String

  @@unique([id, tenantId], map: "af_seg_id_tenant_key")
  @@index([tenantId, empleadoId, vigenteDesde], map: "af_seg_tenant_employee_since_idx")
  @@map("afiliaciones_seguridad_social")
}

// =============================================================================
// CENTRO DE TRABAJO PILA — Código declarado por el aportante a su ARL
// =============================================================================
// No equivale a una sede. El vínculo opcional con Sede es administrativo; el
// código se conserva como dato declarado por el empleador.
// =============================================================================

model PilaCentroTrabajo {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  sedeId String?
  sede   Sede?   @relation(fields: [sedeId, tenantId], references: [id, tenantId], onDelete: Restrict)

  arlCodigo    String  @db.VarChar(6)
  codigoCentro String  @db.VarChar(40)
  nombre       String  @db.VarChar(120)
  activo       Boolean @default(true)

  asignaciones PilaAsignacionCentroTrabajo[]

  @@unique([id, tenantId], map: "pila_centros_trabajo_id_tenant_key")
  @@unique([tenantId, arlCodigo, codigoCentro], map: "pila_centros_tenant_arl_code_key")
  @@index([tenantId, activo], map: "pila_centros_tenant_active_idx")
  @@index([tenantId, sedeId], map: "pila_centros_tenant_sede_idx")
  @@map("pila_centros_trabajo")
}

// =============================================================================
// ASIGNACIÓN PILA — Centro ARL y actividad con vigencia por empleado
// =============================================================================

model PilaAsignacionCentroTrabajo {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId, tenantId], references: [id, tenantId], onDelete: Restrict)

  centroTrabajoId String
  centroTrabajo   PilaCentroTrabajo @relation(fields: [centroTrabajoId, tenantId], references: [id, tenantId], onDelete: Restrict)

  codigoActividadEconomica String   @db.VarChar(7)
  formatoNormativoVersion String   @default("DECRETO_768_2022") @db.VarChar(32)
  vigenteDesde            DateTime @db.Date
  vigenteHasta            DateTime? @db.Date
  registradoPorId         String

  @@unique([id, tenantId], map: "pila_asignaciones_centro_id_tenant_key")
  @@index([tenantId, empleadoId, vigenteDesde], map: "pila_asignaciones_tenant_employee_since_idx")
  @@index([tenantId, centroTrabajoId, vigenteDesde], map: "pila_asignaciones_tenant_center_since_idx")
  @@map("pila_asignaciones_centro_trabajo")
}

// =============================================================================
// PLANTILLA — Plantilla DOCX para generación de documentos
// =============================================================================
// Archivo DOCX almacenado en R2 con marcadores de variables ({{variable}}).
// El campo variablesMapa es un JSON que mapea marcadores a campos del Empleado.
// Ejemplo: { "{{nombre_completo}}": "empleado.primerNombre + empleado.primerApellido" }
// Un tenant puede tener múltiples plantillas por tipo de documento.
// =============================================================================

model Plantilla {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre      String
  descripcion String?
  tipo        PlantillaTipo
  storageKey  String // Ruta en R2: {tenantId}/plantillas/{id}.docx
  activa      Boolean       @default(true)

  // JSON con el mapa de variables de la plantilla
  // Estructura: { "{{MARCADOR}}": "campo.ruta" | "literal:valor" }
  variablesMapa Json @default("{}")

  // Relaciones
  contratos Contrato[]

  @@index([tenantId, tipo])
  @@index([tenantId, activa])
  @@map("plantillas")
}

// =============================================================================
// DOCUMENT TEMPLATE TYPE — Enumerado de tipos de documento plantilla
// =============================================================================

enum DocumentTemplateType {
  CONTRACT
  CERTIFICATION
  LETTER
  MEMO
}

enum BatchDocumentGenerationPlanStatus {
  CONFIRMADO
  CONSUMIDO
  ANULADO
}

enum GeneratedDocumentStatus {
  PENDIENTE_MATERIALIZACION
  MATERIALIZADO
  FALLIDO
  LEGADO_NO_VERIFICADO
}

// =============================================================================
// DOCUMENT TEMPLATE — Plantilla base del motor documental (Fase 1)
// =============================================================================
// Entidad genérica y reutilizable para cualquier tipo de documento.
// El contenido almacena el texto con placeholders {{VARIABLE}}.
// Las variables disponibles son las definidas en el módulo de plantillas
// (NOMBRE_COMPLETO, DOCUMENTO, CARGO, SALARIO, TIPO_CONTRATO, etc.)
//
// Futura evolución:
//   DocumentTemplate → GeneratedDocument → PDF → ExpedienteDoc → Alertas
// =============================================================================

model DocumentTemplate {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  nombre      String
  descripcion String?
  tipo        DocumentTemplateType
  contenido   String // Texto con placeholders {{VARIABLE}}
  activo      Boolean              @default(true)

  // Relaciones
  generatedDocuments GeneratedDocument[]
  lotes              LoteContrato[]
  configuracionesDocumentalesPerfil ConfiguracionDocumentalPerfil[]

  @@index([tenantId])
  @@index([tenantId, tipo])
  @@index([tenantId, activo])
  @@index([tenantId, deletedAt])
  @@map("document_templates")
}

// =============================================================================
// GENERATED DOCUMENT — Documento generado desde una plantilla (Fase 2)
// =============================================================================
// Representa un documento concreto generado a partir de una plantilla
// y los datos de un empleado. El contenidoFinal es un snapshot inmutable:
// aunque el empleado cambie de cargo, salario o dependencia después,
// el documento generado conserva los valores originales del momento.
//
// Futura evolución:
//   GeneratedDocument → PDF → ExpedienteDoc → Alertas
// =============================================================================

model GeneratedDocument {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Empleado @relation(fields: [employeeId], references: [id])

  templateId String
  template   DocumentTemplate @relation(fields: [templateId], references: [id])

  contratoId String?
  contrato   Contrato? @relation(fields: [contratoId], references: [id])

  // Identidad de origen para la generación documental por lote. Se mantiene
  // en GeneratedDocument para que el plan confirmado no dependa del documento
  // materializado, pero cada reintento pueda reutilizar su mismo artefacto.
  batchDocumentGenerationPlanId String? @unique

  nombre         String // Nombre del documento generado
  contenidoFinal String // Contenido con variables ya reemplazadas (snapshot inmutable)
  // `pdfStorageKey` identifica el artefacto PDF canónico en el proveedor de
  // almacenamiento. `pdfUrl` se preserva como locator de presentación para
  // compatibilidad con los consumidores actuales.
  pdfStorageKey String?
  pdfSizeBytes  Int?
  pdfUrl        String?
  tipo           DocumentTemplateType
  estado         GeneratedDocumentStatus @default(PENDIENTE_MATERIALIZACION)

  // Relaciones
  expedienteDocs ExpedienteDoc[]

  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, tipo])
  @@index([tenantId, estado])
  @@index([tenantId, createdAt])
  @@index([tenantId, contratoId])
  @@map("generated_documents")
}

