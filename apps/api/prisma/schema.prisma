  @@index([runId, status])
  @@map("alert_generation_run_tenants")
}

// =============================================================================
// PAYROLL PERIOD STATUS — Estado del período de nómina
// =============================================================================

enum PayrollPeriodStatus {
  // ── Legado (P0/N2) — sin uso en código nuevo desde P1/U1 ───────────────────
  // Postgres no permite eliminar valores de un enum sin recrear el tipo;
  // se preservan inertes. Backfill en U1: DRAFT → BORRADOR, CLOSED → CERRADA.
  DRAFT
  CLOSED

  // ── Máquina de estados del ProcesoNómina (ADR-002 §6, P1/U1) ───────────────
  // BORRADOR ─calcular→ CALCULADA ─enviar a revisión→ EN_REVISION ─aprobar→ APROBADA
  // CALCULADA ─reabrir→ BORRADOR · EN_REVISION ─rechazar→ CALCULADA
  // APROBADA es terminal en P1; P2 añadirá CAUSADA de forma aditiva (sin rename).
  BORRADOR
  CALCULADA
  EN_REVISION
  APROBADA
  CAUSADA
  // CERRADA en U1/P1 es EXCLUSIVAMENTE legado: solo lo puebla el backfill de
  // la migración (CLOSED → CERRADA). Ningún flujo nuevo de U1 transiciona
  // hacia CERRADA — no aparece como destino en VALID_TRANSITIONS
  // (payroll-states.ts). La transición funcional real PAGADA → CERRADA la
  // añade P3; hasta entonces, un período llega aquí solo si ya estaba
  // CLOSED antes de U1.
  CERRADA
}

// =============================================================================
// PAYROLL CONCEPT TYPE — Tipo de concepto (devengo o deducción)
// =============================================================================

enum PayrollConceptType {
  EARNING // Devengo del empleado: salario, auxilio, bonos, extras
  DEDUCTION // Deducción del empleado: salud 4%, pensión 4%, FSP
  EMPLOYER_CONTRIBUTION // Aporte patronal: salud 8.5%, pensión 12%, ARL, caja, ICBF, SENA
  PROVISION // N2B — provisión prestacional: prima, cesantías, intereses, vacaciones
}

// =============================================================================
// PAYROLL NOVELTY TYPE — Tipo de novedad de nómina
// =============================================================================

enum PayrollNoveltyType {
  VACATION
  SICKNESS
  LICENSE
  OVERTIME
  BONUS
  OTHER
}

enum PilaEventCode {
  ING
  RET
  VSP
  VST
  SLN
  IGE
  LMA
  VAC_LR
  IRL
  VCT
}

// =============================================================================
// PAYROLL BLOCK STATUS — Ciclo de vida de bloqueos fail-secure
// =============================================================================

enum PayrollBlockStatus {
  ACTIVE
  RESOLVED
  EXCLUDED
}

// =============================================================================
// PAYROLL CORRECTION STATUS — Ciclo de vida de la corrección post-aprobación
// =============================================================================

enum PayrollCorrectionStatus {
  BORRADOR
  EN_REVISION
  APROBADA
  RECHAZADA
  CANCELADA
}

enum ServicePremiumBatchStatus {
  BORRADOR
  APROBADO
  PROCESANDO
  COMPLETADO
  COMPLETADO_CON_BLOQUEOS
  ERROR
  ANULADO
}

