# Copy this file to the VPS as .env. Never commit the real file.
# The API image must use an immutable commit-SHA tag published by GHCR.
API_IMAGE=ghcr.io/OWNER/REPOSITORY/api:sha-COMMIT_SHA

# Host directory mounted into the API container.
UPLOADS_PATH=/home/ubuntu/la-oficina-nitida/uploads

NODE_ENV=production
PORT=4000

# This is the non-privileged runtime connection. The hostname is the existing
# PostgreSQL container on the la-oficina-nitida_laoficina Docker network.
DATABASE_URL=postgresql://saas_api_runtime:replace-with-runtime-password@postgres:5432/oficina_nitida?schema=public

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=https://staging.dusema.com
BACKEND_URL=https://staging-api.dusema.com
ALLOWED_ORIGINS=https://staging.dusema.com

STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=/app/uploads
REQUIRE_REAL_EMAIL=false

# Do not add DATABASE_URL_MIGRATION here. It is used only for an explicit,
# operator-run Prisma migration after the staging database is confirmed.
# Do not add REDIS_URL, R2_* or email-provider secrets for this initial staging.
