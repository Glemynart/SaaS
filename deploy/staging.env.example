# Copy this file to the VPS as .env. Never commit the real file.
# The API image must use an immutable commit-SHA tag published by GHCR.
API_IMAGE=ghcr.io/OWNER/REPOSITORY/api:sha-COMMIT_SHA

NODE_ENV=production
PORT=4000

# Replace these placeholders only after a separate staging database and a
# dedicated runtime role are approved and verified. Do not reuse
# oficina_nitida or saas_api_runtime from the environment classified as production.
DATABASE_URL=postgresql://REPLACE_WITH_STAGING_RUNTIME_ROLE:REPLACE_WITH_RUNTIME_PASSWORD@postgres:5432/REPLACE_WITH_APPROVED_STAGING_DATABASE?schema=public

JWT_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Static S2S administrative integration key. Leave unset when the POS is not enabled.
PLATFORM_S2S_ISSUER=
PLATFORM_S2S_AUDIENCE=
PLATFORM_S2S_KID=
PLATFORM_S2S_PUBLIC_KEY=

FRONTEND_URL=https://staging.dusema.com
BACKEND_URL=https://staging-api.dusema.com
ALLOWED_ORIGINS=https://staging.dusema.com

STORAGE_PROVIDER=r2
R2_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=REPLACE_WITH_STAGING_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_STAGING_SECRET_ACCESS_KEY
R2_BUCKET=REPLACE_WITH_PRIVATE_STAGING_BUCKET

# OCI Email Delivery SMTP. Never commit the real password.
EMAIL_SMTP_HOST=smtp.email.sa-bogota-1.oci.oraclecloud.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=<smtp-username>
EMAIL_SMTP_PASSWORD=<smtp-password>
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_REQUIRE_TLS=true
EMAIL_FROM=no-reply@dusema.com
EMAIL_FROM_NAME=<display-name>
REQUIRE_REAL_EMAIL=true

# Do not add DATABASE_URL_MIGRATION here. It is used only for an explicit,
# operator-run Prisma migration after the staging database is confirmed.
# R2_* is required by this isolated staging configuration. Do not add REDIS_URL
# unless Redis is explicitly integrated into the staging deployment.
