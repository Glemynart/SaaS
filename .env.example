# Runtime mode. The same names are used by the API and the web service where applicable.
NODE_ENV=development

# API — database connection (Prisma / PostgreSQL).
# docker-compose.yml exposes PostgreSQL on host port 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/saas_db?schema=public"
# Deployment-only privileged connection for `prisma migrate deploy`. Never set
# this value on the API runtime service; its DATABASE_URL must use the
# non-superuser, non-BYPASSRLS application role.
# DATABASE_URL_MIGRATION="postgresql://migration_user:password@host:5432/db?schema=public"
PORT=4000
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
ALLOWED_ORIGINS="http://localhost:3000"

# API — security. Replace this value outside local development.
JWT_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# API — optional infrastructure integrations. These are configured as service
# variables in staging; do not commit their values.
REDIS_URL="redis://localhost:6379"
STORAGE_PROVIDER="local"
STORAGE_LOCAL_ROOT="./uploads"
# STORAGE_PROVIDER="r2"
# R2_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET=""
# EMAIL_SMTP_HOST=""
# EMAIL_SMTP_PORT="587"
# EMAIL_SMTP_USER=""
# EMAIL_SMTP_PASSWORD=""
# EMAIL_SMTP_SECURE="false"
# EMAIL_SMTP_REQUIRE_TLS="true"
# EMAIL_FROM=""
# EMAIL_FROM_NAME=""
# REQUIRE_REAL_EMAIL="false"

# Web — API URLs. API_URL is server-side; NEXT_PUBLIC_API_URL is exposed to
# the browser and therefore must never contain credentials.
API_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
